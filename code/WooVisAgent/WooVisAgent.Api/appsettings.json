{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "WooVisAgent",
    "Audience": "WooVisAgent",
    "SigningKey": "woovisagent-dev-signing-key-please-override-in-production",
    "ExpireMinutes": 720
  },
  "Identity": {
    "RequireEmailCode": false,
    "EmailCodeExpireSeconds": 300,
    "ExposeEmailCodeInResponse": true,
    "DefaultRole": "User"
  },
  "Database": {
    "AutoInitialize": true
  }
}
