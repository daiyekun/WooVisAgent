# ==============================================================================
# WooVisAgent 仓库根 .gitignore
#
# 原则：只写「任意层级都匹配」的通配规则，不写死具体项目名。
# 这样仓库里现有的十几个项目（Api / AppHost / GenerateWorker / Services.* /
# Web / tests ...）以及以后新增的项目都自动生效，不用再逐个补路径。
#
# 注意：不以 / 开头的模式会匹配任意子目录，例如 bin/ 等价于 **/bin/
# ==============================================================================

# ------------------------------------------------------------------------------
# .NET 编译产物
# ------------------------------------------------------------------------------
# 任意层级的 bin / obj（所有项目共用，这是本文件的核心规则）
[Bb]in/
[Oo]bj/

# dotnet publish / 统一输出目录
artifacts/
publish/
*.deps.json
*.runtimeconfig.json
*.runtimeconfig.dev.json
*.staticwebassets.endpoints.json

# ASP.NET 开发期生成的文件
*.dbmdl
*.jfm
*.pidb
*.svclog

# NuGet 还原产物
*.nuget.props
*.nuget.targets
packages/
*.nupkg
*.snupkg

# ------------------------------------------------------------------------------
# 测试与覆盖率
# ------------------------------------------------------------------------------
[Tt]est[Rr]esult*/
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.coverlet.json

# ------------------------------------------------------------------------------
# 前端（WooVisAgent.Web）
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# 包管理器调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 本地环境覆盖文件（.env.development / .env.production 团队共用，保留提交）
.env.local
.env.*.local
*.local

# ------------------------------------------------------------------------------
# IDE / 编辑器
# ------------------------------------------------------------------------------
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.csproj.user
*.DotSettings.user
*.sw?
*.orig
*.rej
*.bak
*~

# ------------------------------------------------------------------------------
# Aspire / 容器本地缓存
# ------------------------------------------------------------------------------
.aspire/
.docker/

# ------------------------------------------------------------------------------
# 运行时产生的用户资源（生成出来的图片/视频不应进仓库）
# 存储根目录在仓库外（D:/uploads），这里只兜住 API 的 wwwroot
# ------------------------------------------------------------------------------
**/wwwroot/uploads/

# ------------------------------------------------------------------------------
# 日志与临时文件
# ------------------------------------------------------------------------------
*.log
logs/
[Tt]emp/
[Tt]mp/
*.tmp
*.cache

# ------------------------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
